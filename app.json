{
  "expo": {
    "name": "social-network",
    "slug": "social-network",
    "scheme": "social-network-scheme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/WIAinst.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vashchenkoartem.socialnetwork",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/WIAinst.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./src/assets/WIAinst.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/WITfavicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df3498ed-7f81-496a-969a-0d030a04100d"
      }
    }
  }
}
